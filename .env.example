# URL pública del sitio (para metadata y Open Graph)
NEXT_PUBLIC_SITE_URL=https://nutriorden.com

# Contacto (footer y resultado de la evaluación)
# WhatsApp en formato internacional, solo dígitos (ej. 50688887777)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Evaluación
# Webhook que recibe cada lead (Make, Zapier o Google Apps Script). Solo servidor.
LEADS_WEBHOOK_URL=
# Calendly para agendar la llamada (ej. https://calendly.com/nutriorden/llamada)
NEXT_PUBLIC_CALENDLY_URL=
# Video de ventas (VSL). Oculto salvo que SHOW_VSL sea "true".
NEXT_PUBLIC_SHOW_VSL=false
NEXT_PUBLIC_VSL_URL=

# Medición (opcionales: si están vacías no se carga nada)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
